# ─────────────────────────────────────────────────────────────
# flmo 환경변수 예시
# 실제 값은 .env.local 에 넣으세요 (.gitignore 처리되어 있습니다)
# ─────────────────────────────────────────────────────────────

# [필수] 저장된 자격증명을 암호화할 키.
# 아래 명령으로 생성하세요:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLMO_ENCRYPTION_KEY=

# [선택] Meta Marketing API 버전. 미지정 시 v25.0
META_API_VERSION=v25.0

# ─────────────────────────────────────────────────────────────
# 아래 두 값은 웹 UI(/setup)에서 입력하면 자동 저장되므로
# 보통 여기에 적을 필요가 없습니다.
# CI/크론처럼 UI 없이 돌릴 때만 사용하세요.
# ─────────────────────────────────────────────────────────────

# 광고 계정 ID (act_ 접두사 포함)
# META_AD_ACCOUNT_ID=act_1234567890

# 시스템 사용자 장기 액세스 토큰
# META_ACCESS_TOKEN=
