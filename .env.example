# ─────────────────────────────────────────────────────────────
# flmo 환경변수 예시
# 실제 값은 .env.local 에 넣으세요 (.gitignore 처리되어 있습니다)
# ─────────────────────────────────────────────────────────────

# [필수] 저장된 설정을 암호화할 키.
# 아래 명령으로 생성하세요:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLMO_ENCRYPTION_KEY=

# [선택] Meta Marketing API 버전. 미지정 시 v25.0
META_API_VERSION=v25.0

# ─────────────────────────────────────────────────────────────
# 아래 값들은 웹 UI(/settings)에서 입력하면 암호화 저장되므로
# 보통 여기에 적을 필요가 없습니다.
# CI·크론처럼 UI 없이 돌릴 때만 사용하세요. 파일보다 우선 적용됩니다.
# ─────────────────────────────────────────────────────────────

# META_AD_ACCOUNT_ID=act_1234567890
# META_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# 테스트 전용 — 외부 호출 대상을 모의 서버로 바꿉니다.
# 운영에서는 절대 설정하지 마세요.
# ─────────────────────────────────────────────────────────────

# META_GRAPH_BASE=http://127.0.0.1:4557
# MUSINSA_BASE=http://127.0.0.1:4556
